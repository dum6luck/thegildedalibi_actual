--- !u!1 &735867181
GameObject:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  serializedVersion: 6
  m_Component:
  - component: {fileID: 735867186}
  - component: {fileID: 735867185}
  - component: {fileID: 735867184}
  - component: {fileID: 735867183}
  - component: {fileID: 735867182}
  m_Layer: 0
  m_Name: Harlow (1)
  m_TagString: NPC
  m_Icon: {fileID: 0}
  m_NavMeshLayer: 0

  m_Name: 
  m_EditorClassIdentifier: 
  nameDisplay: {fileID: 1547887588}
  dialogueDisplay: {fileID: 558970226}
  nextArrow: {fileID: 1854471063}
  dialoguePanel: {fileID: 1613754594}
  uiFader: {fileID: 1613754599}
  mingleTracker: {fileID: 1925568599}
  cameraTargetGroup: {fileID: 0}
  typingSpeed: 0.0338
  triggerSentence: Ugh, I need the bathroom. These bright lights are making my head

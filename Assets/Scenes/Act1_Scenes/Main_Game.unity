  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 867229018}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f6112415d972b4e6bbaae5d443be5a9f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npc: {fileID: 867229019}
  dialogue: Need something?
  maskClueID: Mask
  maskInvestigatedResponse: You didn't find anything on the mask? I thought there
    was something...
  clue_keys:
  - Stab Wounds
  - Blood Smear
  - Caesar Woodworking
  - Random Code
  - Glove Fiber
  - Fake Dagger
  dialogue_values:
  - "That\u2019s\u2026 a lot of force behind it. It doesn\u2019t look like something
    that happened quickly."
  - "So he moved after he was hurt. That\u2019s not normal."
  - "I don\u2019t recognize the name. It sounds like a supplier or contractor, maybe?"
  - It looks like gibberish. Just ignore it.
  - "A cipher\u2026 of course there\u2019s a cipher. Why would it be on there in
    the first place?"
  - "\u2026That looks like a thick hair. It could be from a coat collar, or something
    like that."
  - It's a replica? How?

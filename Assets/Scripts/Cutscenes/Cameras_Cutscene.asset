%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0cfeb3096ff7f4a8da5cc40215e800ae, type: 3}
  m_Name: Cameras_Cutscene
  m_EditorClassIdentifier: 
  backgroundSprite: {fileID: 21300000, guid: e3c711703880e2b4282ca3b970aff1fe, type: 3}
  frames:
  - leftCharacterSprite: {fileID: 21300000, guid: 332c630027153654ba758ceb5b85def6,
      type: 3}
    rightCharacterSprite: {fileID: 0}
    activeSpeaker: 0
    speaker: {fileID: 11400000, guid: 329b9859f8b23433da699c8ff652b3b2, type: 2}
    isItalic: 0
    dialogueLine: "Let's see what these caught.\r"
  - leftCharacterSprite: {fileID: 21300000, guid: 332c630027153654ba758ceb5b85def6,
      type: 3}
    rightCharacterSprite: {fileID: 0}
    activeSpeaker: 0
    speaker: {fileID: 11400000, guid: 329b9859f8b23433da699c8ff652b3b2, type: 2}
    isItalic: 0
    dialogueLine: "...Huh.\r"
  - leftCharacterSprite: {fileID: 21300000, guid: 332c630027153654ba758ceb5b85def6,
      type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: 57d06ee28d045874598b4cee3993f805,
      type: 3}
    activeSpeaker: 1
    speaker: {fileID: 11400000, guid: 00eecea0f8d2943d3aa995fbef1d985d, type: 2}
    isItalic: 0
    dialogueLine: "What is it?\r"
  - leftCharacterSprite: {fileID: 21300000, guid: 332c630027153654ba758ceb5b85def6,
      type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: 57d06ee28d045874598b4cee3993f805,
      type: 3}
    activeSpeaker: 0
    speaker: {fileID: 11400000, guid: 329b9859f8b23433da699c8ff652b3b2, type: 2}
    isItalic: 0
    dialogueLine: "There's nothing to flip through. No feed at all. Just black, on
      every screen.\r"
  - leftCharacterSprite: {fileID: 21300000, guid: 332c630027153654ba758ceb5b85def6,
      type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: 57d06ee28d045874598b4cee3993f805,
      type: 3}
    activeSpeaker: 0
    speaker: {fileID: 11400000, guid: 329b9859f8b23433da699c8ff652b3b2, type: 2}
    isItalic: 0
    dialogueLine: 'System''s on. It''s just not receiving anything.

'
  - leftCharacterSprite: {fileID: 21300000, guid: 332c630027153654ba758ceb5b85def6,
      type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: ec2a29aabc4a6104ebc48cdff4a433a9,
      type: 3}
    activeSpeaker: 1
    speaker: {fileID: 11400000, guid: 563107da4e7244f8a8b338e4baaec6d9, type: 2}
    isItalic: 0
    dialogueLine: 'So the cameras are broken?

'
  - leftCharacterSprite: {fileID: 21300000, guid: 332c630027153654ba758ceb5b85def6,
      type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: ec2a29aabc4a6104ebc48cdff4a433a9,
      type: 3}
    activeSpeaker: 0
    speaker: {fileID: 11400000, guid: 329b9859f8b23433da699c8ff652b3b2, type: 2}
    isItalic: 0
    dialogueLine: 'Someone wanted to make sure they were off.

'
  - leftCharacterSprite: {fileID: 21300000, guid: 332c630027153654ba758ceb5b85def6,
      type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: 8100e67ebce1a124183e9722ddee88b1,
      type: 3}
    activeSpeaker: 1
    speaker: {fileID: 11400000, guid: 231320708aa324d678354913ac00d9c0, type: 2}
    isItalic: 0
    dialogueLine: 'Since when?

'
  - leftCharacterSprite: {fileID: 21300000, guid: 332c630027153654ba758ceb5b85def6,
      type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: 8100e67ebce1a124183e9722ddee88b1,
      type: 3}
    activeSpeaker: 0
    speaker: {fileID: 11400000, guid: 329b9859f8b23433da699c8ff652b3b2, type: 2}
    isItalic: 0
    dialogueLine: "Can't say exactly\u2026 there's nothing here to check the timestamp
      against.\r\n"
  - leftCharacterSprite: {fileID: 21300000, guid: 332c630027153654ba758ceb5b85def6,
      type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: f2a0aadb7a19e21488898a4a61a5cc96,
      type: 3}
    activeSpeaker: 1
    speaker: {fileID: 11400000, guid: 00eecea0f8d2943d3aa995fbef1d985d, type: 2}
    isItalic: 0
    dialogueLine: 'That can''t be right. This system is tested weekly.

'
  - leftCharacterSprite: {fileID: 21300000, guid: 332c630027153654ba758ceb5b85def6,
      type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: 8100e67ebce1a124183e9722ddee88b1,
      type: 3}
    activeSpeaker: 1
    speaker: {fileID: 11400000, guid: 231320708aa324d678354913ac00d9c0, type: 2}
    isItalic: 0
    dialogueLine: "So there's nothing from tonight?\r"
  - leftCharacterSprite: {fileID: 21300000, guid: 332c630027153654ba758ceb5b85def6,
      type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: 903afd396953c2b4e957d32948a8f021,
      type: 3}
    activeSpeaker: 1
    speaker: {fileID: 11400000, guid: 563107da4e7244f8a8b338e4baaec6d9, type: 2}
    isItalic: 0
    dialogueLine: "Somebody's really covering their tracks.\r"
  - leftCharacterSprite: {fileID: 21300000, guid: 332c630027153654ba758ceb5b85def6,
      type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: 903afd396953c2b4e957d32948a8f021,
      type: 3}
    activeSpeaker: 0
    speaker: {fileID: 11400000, guid: 329b9859f8b23433da699c8ff652b3b2, type: 2}
    isItalic: 0
    dialogueLine: "Dr. Harlow, who has access to this system?\r"
  - leftCharacterSprite: {fileID: 21300000, guid: 332c630027153654ba758ceb5b85def6,
      type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: f2a0aadb7a19e21488898a4a61a5cc96,
      type: 3}
    activeSpeaker: 1
    speaker: {fileID: 11400000, guid: 00eecea0f8d2943d3aa995fbef1d985d, type: 2}
    isItalic: 0
    dialogueLine: "Only staff of the museum.\r"
  - leftCharacterSprite: {fileID: 21300000, guid: 903afd396953c2b4e957d32948a8f021,
      type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: f2a0aadb7a19e21488898a4a61a5cc96,
      type: 3}
    activeSpeaker: 0
    speaker: {fileID: 11400000, guid: 563107da4e7244f8a8b338e4baaec6d9, type: 2}
    isItalic: 0
    dialogueLine: ...
  - leftCharacterSprite: {fileID: 21300000, guid: 903afd396953c2b4e957d32948a8f021,
      type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: 5ef972a4c46a94e4f86a5481ade1422c,
      type: 3}
    activeSpeaker: 1
    speaker: {fileID: 11400000, guid: 914e50fe5d95b48cf907723d5aff0248, type: 2}
    isItalic: 0
    dialogueLine: ...
  - leftCharacterSprite: {fileID: 21300000, guid: 3b54442e51286fc458f735252ee3c2e2,
      type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: 5ef972a4c46a94e4f86a5481ade1422c,
      type: 3}
    activeSpeaker: 0
    speaker: {fileID: 11400000, guid: 231320708aa324d678354913ac00d9c0, type: 2}
    isItalic: 0
    dialogueLine: D-dont look at me! We are technically all employees of Max. I don't
      even have a security card to get in here.
  - leftCharacterSprite: {fileID: 21300000, guid: 3b54442e51286fc458f735252ee3c2e2,
      type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: 57d06ee28d045874598b4cee3993f805,
      type: 3}
    activeSpeaker: 1
    speaker: {fileID: 11400000, guid: 00eecea0f8d2943d3aa995fbef1d985d, type: 2}
    isItalic: 0
    dialogueLine: "I don't like what that implies\u2026"

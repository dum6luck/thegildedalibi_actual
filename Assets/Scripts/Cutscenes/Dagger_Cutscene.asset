%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0cfeb3096ff7f4a8da5cc40215e800ae, type: 3}
  m_Name: Dagger_Cutscene
  m_EditorClassIdentifier: 
  backgroundSprite: {fileID: 21300000, guid: 5749103293338694c99738a7104fbf99, type: 3}
  frames:
  - leftCharacterSprite: {fileID: 21300000, guid: 0eb9d0631edfb60419df2c025bd4af07,
      type: 3}
    rightCharacterSprite: {fileID: 0}
    activeSpeaker: 0
    speakerName: IRIS GABLE
    isItalic: 0
    dialogueLine: "This has to be the murder weapon. It's in plain sight!\r"
  - leftCharacterSprite: {fileID: 21300000, guid: 0eb9d0631edfb60419df2c025bd4af07,
      type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: 9c8f320fb24652748bda3d97fbba4e7b,
      type: 3}
    activeSpeaker: 1
    speakerName: JULIAN VANE
    isItalic: 0
    dialogueLine: 'Behind glass, Iris. Not exactly plain sight if you need a locked
      case to keep it in.

'
  - leftCharacterSprite: {fileID: 21300000, guid: 5ef972a4c46a94e4f86a5481ade1422c,
      type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: 9c8f320fb24652748bda3d97fbba4e7b,
      type: 3}
    activeSpeaker: 0
    speakerName: IRIS GABLE
    isItalic: 0
    dialogueLine: 'You know what I mean.

'
  - leftCharacterSprite: {fileID: 21300000, guid: 332c630027153654ba758ceb5b85def6,
      type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: 9c8f320fb24652748bda3d97fbba4e7b,
      type: 3}
    activeSpeaker: 0
    speakerName: DETECTIVE
    isItalic: 0
    dialogueLine: Let me take a look.
  - leftCharacterSprite: {fileID: 21300000, guid: 332c630027153654ba758ceb5b85def6,
      type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: d4d7669b0858d474db0f4e362b34219a,
      type: 3}
    activeSpeaker: 0
    speakerName: DETECTIVE
    isItalic: 0
    dialogueLine: Seems like the case is unlocked already.
  - leftCharacterSprite: {fileID: 21300000, guid: 332c630027153654ba758ceb5b85def6,
      type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: d4d7669b0858d474db0f4e362b34219a,
      type: 3}
    activeSpeaker: 1
    speakerName: DR. HARLOW
    isItalic: 0
    dialogueLine: "That's the ceremonial dagger from the Ottoman collection. Sixteenth
      century, or it's supposed to be.\r"
  - leftCharacterSprite: {fileID: 21300000, guid: 3b0bfe50efe868a4a9ddef4c5d2519d8,
      type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: d4d7669b0858d474db0f4e362b34219a,
      type: 3}
    activeSpeaker: 0
    speakerName: PENNY STERLING
    isItalic: 0
    dialogueLine: Supposed to be?
  - leftCharacterSprite: {fileID: 21300000, guid: 3b0bfe50efe868a4a9ddef4c5d2519d8,
      type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: f2a0aadb7a19e21488898a4a61a5cc96,
      type: 3}
    activeSpeaker: 1
    speakerName: DR. HARLOW
    isItalic: 0
    dialogueLine: ' It''s never left this case in the two years I''ve worked here.
      Max was very particular about it.'
  - leftCharacterSprite: {fileID: 21300000, guid: 332c630027153654ba758ceb5b85def6,
      type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: f2a0aadb7a19e21488898a4a61a5cc96,
      type: 3}
    activeSpeaker: 0
    speakerName: DETECTIVE
    isItalic: 0
    dialogueLine: Mind if I take a look?
  - leftCharacterSprite: {fileID: 21300000, guid: 332c630027153654ba758ceb5b85def6,
      type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: d4d7669b0858d474db0f4e362b34219a,
      type: 3}
    activeSpeaker: 1
    speakerName: DR. HARLOW
    isItalic: 0
    dialogueLine: Feel free, Detective.
  - leftCharacterSprite: {fileID: 21300000, guid: 332c630027153654ba758ceb5b85def6,
      type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: d4d7669b0858d474db0f4e362b34219a,
      type: 3}
    activeSpeaker: 0
    speakerName: DETECTIVE
    isItalic: 0
    dialogueLine: "...This doesn't look right.\r"
  - leftCharacterSprite: {fileID: 21300000, guid: 332c630027153654ba758ceb5b85def6,
      type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: 5ef972a4c46a94e4f86a5481ade1422c,
      type: 3}
    activeSpeaker: 1
    speakerName: IRIS GABLE
    isItalic: 0
    dialogueLine: "What do you mean?\r"
  - leftCharacterSprite: {fileID: 21300000, guid: 332c630027153654ba758ceb5b85def6,
      type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: 5ef972a4c46a94e4f86a5481ade1422c,
      type: 3}
    activeSpeaker: 0
    speakerName: DETECTIVE
    isItalic: 0
    dialogueLine: "The edge. Look at it.\r"
  - leftCharacterSprite: {fileID: 21300000, guid: 332c630027153654ba758ceb5b85def6,
      type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: f2a0aadb7a19e21488898a4a61a5cc96,
      type: 3}
    activeSpeaker: 1
    speakerName: DR. HARLOW
    isItalic: 0
    dialogueLine: "That's dull. Completely dull.\r"
  - leftCharacterSprite: {fileID: 21300000, guid: 8100e67ebce1a124183e9722ddee88b1,
      type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: f2a0aadb7a19e21488898a4a61a5cc96,
      type: 3}
    activeSpeaker: 0
    speakerName: PENNY STERLING
    isItalic: 0
    dialogueLine: You said it's ceremonial. Aren't those things usually decorative?
      Not exactly built for stabbing people.
  - leftCharacterSprite: {fileID: 21300000, guid: 8100e67ebce1a124183e9722ddee88b1,
      type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: 57d06ee28d045874598b4cee3993f805,
      type: 3}
    activeSpeaker: 1
    speakerName: DR. HARLOW
    isItalic: 0
    dialogueLine: " No, this one wasn't just decorative. It was authenticated as
      a functioning blade, that was half of why Max wanted it so badly. He liked
      knowing it could still cut.\r"
  - leftCharacterSprite: {fileID: 21300000, guid: 903afd396953c2b4e957d32948a8f021,
      type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: 57d06ee28d045874598b4cee3993f805,
      type: 3}
    activeSpeaker: 0
    speakerName: JULIAN VANE
    isItalic: 0
    dialogueLine: 'What a charming guy.

'
  - leftCharacterSprite: {fileID: 21300000, guid: 332c630027153654ba758ceb5b85def6,
      type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: 57d06ee28d045874598b4cee3993f805,
      type: 3}
    activeSpeaker: 0
    speakerName: DETECTIVE
    isItalic: 1
    dialogueLine: 'A blade that shouldn''t be sharp isn''t newsworthy. A blade that''s
      supposed to be sharp and isn''t, that''s a problem.

'
  - leftCharacterSprite: {fileID: 21300000, guid: 332c630027153654ba758ceb5b85def6,
      type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: 57d06ee28d045874598b4cee3993f805,
      type: 3}
    activeSpeaker: 0
    speakerName: DETECTIVE
    isItalic: 0
    dialogueLine: 'Dr. Harlow, look at the mark on the blade. Does this match your
      records?


'
  - leftCharacterSprite: {fileID: 21300000, guid: 332c630027153654ba758ceb5b85def6,
      type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: f2a0aadb7a19e21488898a4a61a5cc96,
      type: 3}
    activeSpeaker: 1
    speakerName: DR. HARLOW
    isItalic: 0
    dialogueLine: "The maker's mark is wrong. It's close, but the real one has the
      lines not intersecting in the middle. \n\n"
  - leftCharacterSprite: {fileID: 21300000, guid: 5ef972a4c46a94e4f86a5481ade1422c,
      type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: 57d06ee28d045874598b4cee3993f805,
      type: 3}
    activeSpeaker: 0
    speakerName: IRIS GABLE
    isItalic: 0
    dialogueLine: 'So it''s fake?



'
  - leftCharacterSprite: {fileID: 21300000, guid: 5ef972a4c46a94e4f86a5481ade1422c,
      type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: 57d06ee28d045874598b4cee3993f805,
      type: 3}
    activeSpeaker: 1
    speakerName: DR. HARLOW
    isItalic: 0
    dialogueLine: ' It''s a replica of the real blade, and a very good one. Good
      enough to fool anyone who wasn''t looking closely.


'
  - leftCharacterSprite: {fileID: 21300000, guid: ec2a29aabc4a6104ebc48cdff4a433a9,
      type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: 57d06ee28d045874598b4cee3993f805,
      type: 3}
    activeSpeaker: 0
    speakerName: JULIAN VANE
    isItalic: 0
    dialogueLine: 'So we found the murder weapon and it''s a prop?!


'
  - leftCharacterSprite: {fileID: 21300000, guid: 3b54442e51286fc458f735252ee3c2e2,
      type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: 57d06ee28d045874598b4cee3993f805,
      type: 3}
    activeSpeaker: 0
    speakerName: PENNY STERLING
    isItalic: 0
    dialogueLine: 'So somebody swapped a museum grade replica into a locked case?



'
  - leftCharacterSprite: {fileID: 21300000, guid: 3b54442e51286fc458f735252ee3c2e2,
      type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: f2a0aadb7a19e21488898a4a61a5cc96,
      type: 3}
    activeSpeaker: 1
    speakerName: DR. HARLOW
    isItalic: 0
    dialogueLine: 'You don''t commission a replica like this overnight. And you don''t
      get into the case without a key.



'
  - leftCharacterSprite: {fileID: 21300000, guid: 332c630027153654ba758ceb5b85def6,
      type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: f2a0aadb7a19e21488898a4a61a5cc96,
      type: 3}
    activeSpeaker: 0
    speakerName: DETECTIVE
    isItalic: 0
    dialogueLine: 'Which means this wasn''t improvised. Someone brought a copy, had
      access to the case, made the trade, and took the real dagger.




'
  - leftCharacterSprite: {fileID: 21300000, guid: 332c630027153654ba758ceb5b85def6,
      type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: f2a0aadb7a19e21488898a4a61a5cc96,
      type: 3}
    activeSpeaker: 0
    speakerName: DETECTIVE
    isItalic: 0
    dialogueLine: 'All we know is that there is a real dagger out there somewhere.
      And that they had to do the swap recently.




'
  - leftCharacterSprite: {fileID: 21300000, guid: 332c630027153654ba758ceb5b85def6,
      type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: 5ef972a4c46a94e4f86a5481ade1422c,
      type: 3}
    activeSpeaker: 1
    speakerName: IRIS GABLE
    isItalic: 0
    dialogueLine: ' Which means whoever swapped it still has it. Right now. With
      us.



'
  - leftCharacterSprite: {fileID: 21300000, guid: 57d06ee28d045874598b4cee3993f805,
      type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: 5ef972a4c46a94e4f86a5481ade1422c,
      type: 3}
    activeSpeaker: 0
    speakerName: DR. HARLOW
    isItalic: 0
    dialogueLine: "That's not a comforting thought.\r"
  - leftCharacterSprite: {fileID: 21300000, guid: 57d06ee28d045874598b4cee3993f805,
      type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: 3b54442e51286fc458f735252ee3c2e2,
      type: 3}
    activeSpeaker: 0
    speakerName: PENNY STERLING
    isItalic: 0
    dialogueLine: ' No. It isn''t.'

%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0cfeb3096ff7f4a8da5cc40215e800ae, type: 3}
  m_Name: Sample_Cutscene 2
  m_EditorClassIdentifier: 
  backgroundSprite: {fileID: 21300000, guid: 5749103293338694c99738a7104fbf99, type: 3}
  frames:
  - leftCharacterSprite: {fileID: 21300000, guid: 332c630027153654ba758ceb5b85def6,
      type: 3}
    rightCharacterSprite: {fileID: 0}
    activeSpeaker: 0
    speaker: {fileID: 11400000, guid: 329b9859f8b23433da699c8ff652b3b2, type: 2}
    isItalic: 0
    dialogueLine: "Everyone, give me a little room.\r"
  - leftCharacterSprite: {fileID: 21300000, guid: 332c630027153654ba758ceb5b85def6,
      type: 3}
    rightCharacterSprite: {fileID: 0}
    activeSpeaker: 0
    speaker: {fileID: 11400000, guid: 329b9859f8b23433da699c8ff652b3b2, type: 2}
    isItalic: 1
    dialogueLine: "Multiple stab wounds, seemingly clustered together in one area.
      \r"
  - leftCharacterSprite: {fileID: 21300000, guid: 332c630027153654ba758ceb5b85def6,
      type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: f2a0aadb7a19e21488898a4a61a5cc96,
      type: 3}
    activeSpeaker: 0
    speaker: {fileID: 11400000, guid: 329b9859f8b23433da699c8ff652b3b2, type: 2}
    isItalic: 0
    dialogueLine: "Dr. Harlow, you're the closest thing to medical knowledge in this
      room. I need a second pair of eyes.\r"
  - leftCharacterSprite: {fileID: 21300000, guid: 332c630027153654ba758ceb5b85def6,
      type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: 57d06ee28d045874598b4cee3993f805,
      type: 3}
    activeSpeaker: 1
    speaker: {fileID: 11400000, guid: 00eecea0f8d2943d3aa995fbef1d985d, type: 2}
    isItalic: 0
    dialogueLine: 'I''m a curator, not a coroner. But... yes. Alright.

'
  - leftCharacterSprite: {fileID: 21300000, guid: 8100e67ebce1a124183e9722ddee88b1,
      type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: 57d06ee28d045874598b4cee3993f805,
      type: 3}
    activeSpeaker: 0
    speaker: {fileID: 11400000, guid: 231320708aa324d678354913ac00d9c0, type: 2}
    isItalic: 0
    dialogueLine: 'Do we really need to stand here and watch this?

'
  - leftCharacterSprite: {fileID: 21300000, guid: 8100e67ebce1a124183e9722ddee88b1,
      type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: 903afd396953c2b4e957d32948a8f021,
      type: 3}
    activeSpeaker: 1
    speaker: {fileID: 11400000, guid: 563107da4e7244f8a8b338e4baaec6d9, type: 2}
    isItalic: 0
    dialogueLine: 'Would you rather wait with whoever did it, Penny? Personally I''ll
      take the corpse.

'
  - leftCharacterSprite: {fileID: 21300000, guid: 5ef972a4c46a94e4f86a5481ade1422c,
      type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: 903afd396953c2b4e957d32948a8f021,
      type: 3}
    activeSpeaker: 0
    speaker: {fileID: 11400000, guid: 914e50fe5d95b48cf907723d5aff0248, type: 2}
    isItalic: 0
    dialogueLine: "I don't\u2026 I really don't do well with this kind of thing."
  - leftCharacterSprite: {fileID: 21300000, guid: 7a16ef7adbe7bb44a88ba2e01372b1d6,
      type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: 332c630027153654ba758ceb5b85def6,
      type: 3}
    activeSpeaker: 1
    speaker: {fileID: 11400000, guid: 329b9859f8b23433da699c8ff652b3b2, type: 2}
    isItalic: 0
    dialogueLine: 'You don''t have to come closer. Just stay where you are. If you
      feel nauseous, turn around.

'
  - leftCharacterSprite: {fileID: 21300000, guid: 5ef972a4c46a94e4f86a5481ade1422c,
      type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: 332c630027153654ba758ceb5b85def6,
      type: 3}
    activeSpeaker: 0
    speaker: {fileID: 11400000, guid: 914e50fe5d95b48cf907723d5aff0248, type: 2}
    isItalic: 0
    dialogueLine: 'Thank you.

'
  - leftCharacterSprite: {fileID: 21300000, guid: 5ef972a4c46a94e4f86a5481ade1422c,
      type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: 332c630027153654ba758ceb5b85def6,
      type: 3}
    activeSpeaker: 1
    speaker: {fileID: 11400000, guid: 329b9859f8b23433da699c8ff652b3b2, type: 2}
    isItalic: 0
    dialogueLine: 'Four stab wounds, maybe five. All within a few inches of each
      other.

'
  - leftCharacterSprite: {fileID: 21300000, guid: 5ef972a4c46a94e4f86a5481ade1422c,
      type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: 332c630027153654ba758ceb5b85def6,
      type: 3}
    activeSpeaker: 1
    speaker: {fileID: 11400000, guid: 329b9859f8b23433da699c8ff652b3b2, type: 2}
    isItalic: 1
    dialogueLine: 'Being clustered like that and so close together... this was a
      calculated attack.

'
  - leftCharacterSprite: {fileID: 21300000, guid: f2a0aadb7a19e21488898a4a61a5cc96,
      type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: 332c630027153654ba758ceb5b85def6,
      type: 3}
    activeSpeaker: 0
    speaker: {fileID: 11400000, guid: 00eecea0f8d2943d3aa995fbef1d985d, type: 2}
    isItalic: 0
    dialogueLine: "Who does something like this?\r"
  - leftCharacterSprite: {fileID: 21300000, guid: f2a0aadb7a19e21488898a4a61a5cc96,
      type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: 332c630027153654ba758ceb5b85def6,
      type: 3}
    activeSpeaker: 1
    speaker: {fileID: 11400000, guid: 329b9859f8b23433da699c8ff652b3b2, type: 2}
    isItalic: 0
    dialogueLine: Someone who wasn't planning on him getting back up.
  - leftCharacterSprite: {fileID: 21300000, guid: 903afd396953c2b4e957d32948a8f021,
      type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: 332c630027153654ba758ceb5b85def6,
      type: 3}
    activeSpeaker: 0
    speaker: {fileID: 11400000, guid: 563107da4e7244f8a8b338e4baaec6d9, type: 2}
    isItalic: 0
    dialogueLine: 'That''s... a lot more violent than I expected. For Max, I mean.
      I didn''t think anyone hated him enough for that.



'
  - leftCharacterSprite: {fileID: 21300000, guid: 8100e67ebce1a124183e9722ddee88b1,
      type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: 332c630027153654ba758ceb5b85def6,
      type: 3}
    activeSpeaker: 0
    speaker: {fileID: 11400000, guid: 231320708aa324d678354913ac00d9c0, type: 2}
    isItalic: 0
    dialogueLine: 'Clearly someone did.

'
  - leftCharacterSprite: {fileID: 21300000, guid: 8100e67ebce1a124183e9722ddee88b1,
      type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: 332c630027153654ba758ceb5b85def6,
      type: 3}
    activeSpeaker: 1
    speaker: {fileID: 11400000, guid: 329b9859f8b23433da699c8ff652b3b2, type: 2}
    isItalic: 0
    dialogueLine: 'Wait. That''s not blood pooling. That''s blood trailing.

'
  - leftCharacterSprite: {fileID: 21300000, guid: 57d06ee28d045874598b4cee3993f805,
      type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: 332c630027153654ba758ceb5b85def6,
      type: 3}
    activeSpeaker: 0
    speaker: {fileID: 11400000, guid: 00eecea0f8d2943d3aa995fbef1d985d, type: 2}
    isItalic: 0
    dialogueLine: "Hmm\u2026 There's a trail\u2026 and it runs almost to the north
      wall.\r\n"
  - leftCharacterSprite: {fileID: 21300000, guid: 57d06ee28d045874598b4cee3993f805,
      type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: 332c630027153654ba758ceb5b85def6,
      type: 3}
    activeSpeaker: 1
    speaker: {fileID: 11400000, guid: 329b9859f8b23433da699c8ff652b3b2, type: 2}
    isItalic: 0
    dialogueLine: 'He didn''t die here. He died over there, and somebody moved him.


'
  - leftCharacterSprite: {fileID: 21300000, guid: ec2a29aabc4a6104ebc48cdff4a433a9,
      type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: 332c630027153654ba758ceb5b85def6,
      type: 3}
    activeSpeaker: 0
    speaker: {fileID: 11400000, guid: 563107da4e7244f8a8b338e4baaec6d9, type: 2}
    isItalic: 0
    dialogueLine: 'Moved him?! Why would anyone bother doing that?


'
  - leftCharacterSprite: {fileID: 21300000, guid: ec2a29aabc4a6104ebc48cdff4a433a9,
      type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: 332c630027153654ba758ceb5b85def6,
      type: 3}
    activeSpeaker: 1
    speaker: {fileID: 11400000, guid: 329b9859f8b23433da699c8ff652b3b2, type: 2}
    isItalic: 0
    dialogueLine: "Good question. Nobody drags a body for fun\u2026 you do it to
      control what evidence gets found and what doesn't.\r\n\n"
  - leftCharacterSprite: {fileID: 21300000, guid: 3b54442e51286fc458f735252ee3c2e2,
      type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: 332c630027153654ba758ceb5b85def6,
      type: 3}
    activeSpeaker: 0
    speaker: {fileID: 11400000, guid: 231320708aa324d678354913ac00d9c0, type: 2}
    isItalic: 0
    dialogueLine: 'So he didn''t even die where he''s lying?


'
  - leftCharacterSprite: {fileID: 21300000, guid: 3b54442e51286fc458f735252ee3c2e2,
      type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: 57d06ee28d045874598b4cee3993f805,
      type: 3}
    activeSpeaker: 1
    speaker: {fileID: 11400000, guid: 00eecea0f8d2943d3aa995fbef1d985d, type: 2}
    isItalic: 0
    dialogueLine: 'Penny.


'
  - leftCharacterSprite: {fileID: 21300000, guid: 8100e67ebce1a124183e9722ddee88b1,
      type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: 57d06ee28d045874598b4cee3993f805,
      type: 3}
    activeSpeaker: 0
    speaker: {fileID: 11400000, guid: 231320708aa324d678354913ac00d9c0, type: 2}
    isItalic: 0
    dialogueLine: 'Sorry, sorry.

'
  - leftCharacterSprite: {fileID: 21300000, guid: 5ef972a4c46a94e4f86a5481ade1422c,
      type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: f2a0aadb7a19e21488898a4a61a5cc96,
      type: 3}
    activeSpeaker: 0
    speaker: {fileID: 11400000, guid: 914e50fe5d95b48cf907723d5aff0248, type: 2}
    isItalic: 0
    dialogueLine: 'Dragged... But he''s a big guy. How could someone have done that?

'
  - leftCharacterSprite: {fileID: 21300000, guid: 5ef972a4c46a94e4f86a5481ade1422c,
      type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: 57d06ee28d045874598b4cee3993f805,
      type: 3}
    activeSpeaker: 1
    speaker: {fileID: 11400000, guid: 00eecea0f8d2943d3aa995fbef1d985d, type: 2}
    isItalic: 0
    dialogueLine: "Nineteen years in this building and I've never\u2014 I never thought
      I'd see anything like this.\r"
  - leftCharacterSprite: {fileID: 21300000, guid: 903afd396953c2b4e957d32948a8f021,
      type: 3}
    rightCharacterSprite: {fileID: 21300000, guid: 57d06ee28d045874598b4cee3993f805,
      type: 3}
    activeSpeaker: 0
    speaker: {fileID: 11400000, guid: 563107da4e7244f8a8b338e4baaec6d9, type: 2}
    isItalic: 0
    dialogueLine: "Yeah. Me neither\u2026"
